[Unit]
Description=SOL/USDC Jupiter vs Raydium/Orca arbitrage monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these two paths for your server:
WorkingDirectory=/opt/sol-arb-monitor
ExecStart=/opt/sol-arb-monitor/venv/bin/python /opt/sol-arb-monitor/main.py
Restart=on-failure
RestartSec=10
User=solarb
# Uncomment to cap memory/CPU on a small VPS:
# MemoryMax=256M
# CPUQuota=50%

[Install]
WantedBy=multi-user.target
